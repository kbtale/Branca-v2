---
const { defaultOpen = false } = Astro.props;
---

<details class="contact-modal-container" open={defaultOpen}>
  <summary class="mb-6 cursor-pointer list-none text-center text-lg font-semibold text-white/80 hover:text-white">
    {defaultOpen ? 'Ocultar formulario' : 'Abrir formulario de contacto'}
  </summary>

  <form class="mx-auto w-full max-w-lg space-y-4">
    <div>
      <label for="name" class="mb-2 block text-sm font-medium">Nombre</label>
      <input id="name" name="name" type="text" required class="w-full rounded-lg border border-white/20 bg-black/20 px-3 py-2 focus:border-club-green-light focus:outline-none focus:ring-2 focus:ring-club-green-light" />
    </div>
    <div>
      <label for="email" class="mb-2 block text-sm font-medium">Email</label>
      <input id="email" name="email" type="email" required class="w-full rounded-lg border border-white/20 bg-black/20 px-3 py-2 focus:border-club-green-light focus:outline-none focus:ring-2 focus:ring-club-green-light" />
    </div>
    <div>
      <label for="message" class="mb-2 block text-sm font-medium">Mensaje</label>
      <textarea id="message" name="message" rows="4" required class="w-full rounded-lg border border-white/20 bg-black/20 px-3 py-2 focus:border-club-green-light focus:outline-none focus:ring-2 focus:ring-club-green-light"></textarea>
    </div>
    <div class="text-center">
      <button type="submit" class="rounded-lg bg-club-green-light px-8 py-2 font-bold text-white transition-colors duration-200 hover:bg-club-green-dark">
        Enviar
      </button>
    </div>
  </form>
</details>