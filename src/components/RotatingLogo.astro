<div class="w-24 h-24 logo-orbit">
  <img src="/images/logo.png" alt="Branca Fútbol" class="h-full w-full object-contain" />
</div>

<style>
  .logo-orbit {
    transform-style: preserve-3d;
    perspective: 1000px;
    animation: logo-tilt 8s ease-in-out infinite;
  }

  @keyframes logo-tilt {
    0%,
    100% {
      transform: rotateY(-10deg) rotateX(8deg) scale(1);
    }

    50% {
      transform: rotateY(10deg) rotateX(-8deg) scale(1.02);
    }
  }
</style>