---
const categories = ['Todos', 'Delanteros', 'Centrocampistas', 'Defensas', 'Porteros', 'Cuerpo Técnico'] as const;

const players = [
  { name: 'Carlos Mendoza', position: 'Delantero Centro', category: 'Delanteros', image: '/images/Player1.png', number: 9, icon: '/images/fw.svg' },
  { name: 'Lucas Vázquez', position: 'Extremo Derecho', category: 'Delanteros', image: '/images/Player2.png', number: 11, icon: '/images/fw.svg' },
  { name: 'Javier Morales', position: 'Extremo Izquierdo', category: 'Delanteros', image: '/images/Player3.png', number: 7, icon: '/images/fw.svg' },
  { name: 'Diego Ramírez', position: 'Mediocampista Ofensivo', category: 'Centrocampistas', image: '/images/Player1.png', number: 10, icon: '/images/mid.svg' },
  { name: 'Andrés Silva', position: 'Mediocampista Central', category: 'Centrocampistas', image: '/images/Player2.png', number: 8, icon: '/images/mid.svg' },
  { name: 'Miguel Ángel', position: 'Mediocampista Defensivo', category: 'Centrocampistas', image: '/images/Player3.png', number: 5, icon: '/images/mid.svg' },
  { name: 'Juan García', position: 'Defensa Central', category: 'Defensas', image: '/images/Player1.png', number: 4, icon: '/images/def.svg' },
  { name: 'Roberto López', position: 'Lateral Derecho', category: 'Defensas', image: '/images/Player2.png', number: 2, icon: '/images/def.svg' },
  { name: 'Fernando Castro', position: 'Lateral Izquierdo', category: 'Defensas', image: '/images/Player3.png', number: 3, icon: '/images/def.svg' },
  { name: 'Pablo Martínez', position: 'Defensa Central', category: 'Defensas', image: '/images/Player1.png', number: 6, icon: '/images/def.svg' },
  { name: 'Miguel Torres', position: 'Portero', category: 'Porteros', image: '/images/Player2.png', number: 1, icon: '/images/gk.svg' },
  { name: 'David Sánchez', position: 'Portero', category: 'Porteros', image: '/images/Player3.png', number: 13, icon: '/images/gk.svg' },
  { name: 'Antonio Ruiz', position: 'Director Técnico', category: 'Cuerpo Técnico', image: '/images/Player1.png', role: 'Director Técnico', icon: '/images/mgr.svg' },
  { name: 'Carlos Vega', position: 'Asistente Técnico', category: 'Cuerpo Técnico', image: '/images/Player2.png', role: 'Asistente Técnico', icon: '/images/mgr.svg' },
  { name: 'Luis Hernández', position: 'Preparador Físico', category: 'Cuerpo Técnico', image: '/images/Player3.png', role: 'Preparador Físico', icon: '/images/mgr.svg' },
];
---

<section class="container mx-auto px-4" data-team-section>
  <h2 class="mb-12 text-center text-4xl font-bold">El Equipazo</h2>

  <div class="mb-12 flex flex-wrap justify-center gap-4">
    {categories.map((category) => (
      <button
        type="button"
        data-filter={category}
        class:list={[
          'rounded-full px-6 py-2 transition-all duration-200',
          category === 'Todos' ? 'bg-club-green-light text-white shadow-lg' : 'bg-white/10 hover:bg-white/20'
        ]}
      >
        {category}
      </button>
    ))}
  </div>

  <div class="grid grid-cols-1 justify-items-center gap-8 md:grid-cols-2 lg:grid-cols-3">
    {players.map((player) => (
      <article
        class="player-card group relative w-full max-w-sm overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-b from-white/10 to-club-dark shadow-2xl transition-transform duration-300 hover:-translate-y-1"
        data-player-card
        data-category={player.category}
      >
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.08),transparent_60%)]"></div>
        <div class="relative aspect-[3/4] overflow-hidden">
          <img src={player.image} alt={player.name} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
            <div class="mb-2 flex items-center gap-3">
              <img src={player.icon} alt={player.category} class="h-6 w-6 opacity-90" />
              <h3 class="text-xl font-bold">{player.name}</h3>
            </div>
            <p class="text-sm text-white/90">
              {player.category === 'Cuerpo Técnico' ? player.role : `${player.position} | #${player.number}`}
            </p>
            <div class="mt-3 inline-flex rounded-full border border-club-green-light/20 bg-club-green/20 px-3 py-1 text-xs text-white">
              {player.category}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  const root = document.querySelector('[data-team-section]');

  if (root) {
    const buttons = Array.from(root.querySelectorAll('[data-filter]'));
    const cards = Array.from(root.querySelectorAll('[data-player-card]'));

    const applyFilter = (category) => {
      buttons.forEach((button) => {
        const isActive = button.getAttribute('data-filter') === category;
        button.classList.toggle('bg-club-green-light', isActive);
        button.classList.toggle('text-white', isActive);
        button.classList.toggle('shadow-lg', isActive);
        button.classList.toggle('bg-white/10', !isActive);
        button.classList.toggle('hover:bg-white/20', !isActive);
      });

      cards.forEach((card) => {
        const matches = category === 'Todos' || card.getAttribute('data-category') === category;
        card.classList.toggle('hidden', !matches);
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => applyFilter(button.getAttribute('data-filter') ?? 'Todos'));
    });

    applyFilter('Todos');
  }
</script>